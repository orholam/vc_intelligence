# ---- Core ----
NODE_ENV=development
LOG_LEVEL=info
APP_PORT=4600
API_PUBLIC_ORIGINS=http://localhost:3000

# ---- Database (own instance, see docker-compose.yml) ----
DATABASE_URL=postgres://copyr_intel:intel@localhost:5434/intelligence
# Hosted Supabase (use the direct db.*:5432 URI, not the pooler, for migrate/restore):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# ---- LLM provider (FR-12 / NFR-1) ----
# harness           = external agent answers ALL completions (local waiting-room brain)
# auto              = harness-first; hosted key fallback only if LLM_API_KEY is real
# openai-compatible = hosted models (path 1)
# mock              = offline deterministic provider (tests)
LLM_PROVIDER=harness
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxx
MODEL_MINI=gpt-4o-mini
MODEL_BIG=gpt-4o
MODEL_JUDGE=gpt-4.1
MODEL_EMBED=text-embedding-3-small
EMBEDDING_DIM=256
MONTHLY_BUDGET_USD=250
BUDGET_SOFT_LIMIT_PCT=90

# ---- Harness mode (LLM_PROVIDER=harness|auto) ----
# Shared secret for the internal work API; empty = loopback-only access.
HARNESS_KEY=
# Max wait for a harness answer before the call fails open (pipeline degrades
# exactly like a budget-degraded call — never wedges).
LLM_HARNESS_TIMEOUT_MS=180000
# auto mode: how long a request stays claimable before falling back.
LLM_AUTO_CLAIM_WAIT_MS=5000
# Keep embeddings hosted even in harness mode (clustering needs real vectors;
# falls back to deterministic lexical vectors when no usable key).
LLM_HARNESS_HOSTED_EMBED=true

# ---- Storage (FR-4 raw text bucket; local driver for dev/tests) ----
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_BUCKET=intelligence
S3_ACCESS_KEY_ID=copyr-intel
S3_SECRET_ACCESS_KEY=copyr-intel-secret
LOCAL_STORAGE_DIR=./data/storage

# ---- Fetching (FR-4 / NFR-7) ----
FETCH_USER_AGENT=CopyrIntelligenceBot/0.1 (+https://copyr.example/intelligence-bot; contact@copyr.example)
FETCH_TIMEOUT_MS=10000
FETCH_DOMAIN_MIN_INTERVAL_MS=2000
EXTRACTOR=auto

# Extra collectors (same funnel as RSS). Off by default; turn on if they earn yield.
GDELT_ENABLED=false
GDELT_POLL_MINUTES=15
FORMD_ENABLED=false
LAUNCH_SURFACES_ENABLED=false
RSS_MAX_BACKOFF_HOURS=24

# ---- Retention (NFR-8) ----
HOT_RETENTION_DAYS=180
TEXT_PASSTHROUGH=false

# ---- API (NFR-6) ----
RATE_LIMIT_PER_MIN=60

# ---- Webhooks (FR-21) ----
WEBHOOK_RETRIES=5

# ---- Imports (FR-7) ----
WIKIDATA_SPARQL_ENDPOINT=https://query.wikidata.org/sparql
EDGAR_USER_AGENT=Copyr Intelligence contact@copyr.example
COMPANIES_HOUSE_API_KEY=
SEED_IMPORT_YC_URL=https://www.ycombinator.com/companies
