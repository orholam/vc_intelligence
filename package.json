{
  "name": "@copyr/intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone news-intelligence API service (entity-resolved news signals + ListGen) for Copyr.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env.local src/index.ts --llm=harness",
    "start": "node --env-file=.env dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local src/scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "key:create": "tsx --env-file-if-exists=.env.local src/scripts/create-key.ts",
    "import:wikidata": "tsx --env-file-if-exists=.env.local src/scripts/import-wikidata.ts",
    "import:edgar": "tsx --env-file-if-exists=.env.local src/scripts/import-edgar.ts",
    "import:companies-house": "tsx --env-file-if-exists=.env.local src/scripts/import-companies-house.ts",
    "import:seeds": "tsx --env-file-if-exists=.env.local src/scripts/import-seeds.ts",
    "sources:import": "tsx --env-file-if-exists=.env.local src/scripts/import-sources.ts",
    "import:xmonitor": "tsx --env-file-if-exists=.env.local src/scripts/import-xmonitor.ts",
    "sources:sync-tiers": "tsx --env-file-if-exists=.env.local src/scripts/sync-source-tiers.ts",
    "quality:fuzzydedup": "tsx --env-file-if-exists=.env.local src/scripts/dedupe-fuzzy.ts",
    "quality:deep-clean": "tsx --env-file-if-exists=.env.local src/scripts/deep-clean.ts",
    "quality:rescore-newsworthiness": "tsx --env-file-if-exists=.env.local src/scripts/rescore-newsworthiness.ts",
    "quality:revalidate": "tsx --env-file-if-exists=.env.local src/scripts/revalidate-quality.ts",
    "quality:scrub-kept": "tsx --env-file-if-exists=.env.local src/scripts/scrub-kept-quality.ts",
    "discover": "tsx --env-file-if-exists=.env.local src/scripts/discover-search.ts",
    "backfill": "tsx --env-file-if-exists=.env.local src/scripts/backfill.ts",
    "benchmark:run": "tsx --env-file-if-exists=.env.local src/scripts/run-benchmark.ts",
    "benchmark:monthly": "BENCHMARK_WEBCHECK=keenable tsx --env-file-if-exists=.env.local src/scripts/run-benchmark.ts --window-days=31",
    "pipeline:replay": "tsx --env-file-if-exists=.env.local src/scripts/replay-article.ts",
    "profile:run": "tsx --env-file-if-exists=.env.local src/scripts/profile-run.ts",
    "enrich:new": "tsx --env-file-if-exists=.env.local src/scripts/enrich-new-companies.ts",
    "enrich:status": ".cursor/skills/enrich-new-companies/scripts/status.sh",
    "enrich:queue": ".cursor/skills/enrich-new-companies/scripts/queue.sh",
    "enrich:answer": ".cursor/skills/enrich-new-companies/scripts/answer.sh",
    "enrich:run": ".cursor/skills/enrich-new-companies/scripts/run.sh",
    "profile:rebuild-thin": "tsx --env-file-if-exists=.env.local src/scripts/profile-rebuild-thin.ts",
    "pipeline:reconcile": "tsx --env-file-if-exists=.env.local src/scripts/reconcile.ts",
    "rubric:probes": "tsx --env-file-if-exists=.env.local src/scripts/rubric-probes.ts",
    "rubric:sample": "tsx --env-file-if-exists=.env.local src/scripts/rubric-sample.ts",
    "worker:start": "node --env-file=.env dist/index.js --mode=worker",
    "api:start": "node --env-file=.env dist/index.js --mode=api",
    "mcp:start": "node --env-file=.env dist/mcp/server.js",
    "companies:dupes": "tsx --env-file-if-exists=.env.local src/scripts/find-duplicate-companies.ts",
    "rubric:remediate": "tsx --env-file-if-exists=.env.local src/scripts/rubric-remediate.ts",
    "rubric:score": "tsx --env-file-if-exists=.env.local src/scripts/rubric.ts",
    "recluster-facts": "tsx --env-file-if-exists=.env.local src/scripts/recluster-facts.ts",
    "enrich:formd": "tsx --env-file-if-exists=.env.local src/scripts/enrich-formd.ts",
    "refilter-legacy": "tsx --env-file-if-exists=.env.local src/scripts/refilter-legacy.ts",
    "enrich:edgar-privates": "tsx --env-file-if-exists=.env.local src/scripts/enrich-edgar-privates.ts",
    "classify:unclassified": "tsx --env-file-if-exists=.env.local src/scripts/classify-unclassified.ts",
    "calibration:apply": "tsx --env-file-if-exists=.env.local src/scripts/apply-calibration.ts",
    "backfill:countries": "tsx --env-file-if-exists=.env.local src/scripts/backfill-countries.mts",
    "strengthen:facts": "tsx --env-file-if-exists=.env.local src/scripts/strengthen-facts.mts",
    "consolidate:stories": "tsx --env-file-if-exists=.env.local src/scripts/consolidate-event-stories.mts",
    "regen:failing-summaries": "tsx --env-file-if-exists=.env.local src/scripts/regen-failing-summaries.mts",
    "profile:autoauthor": "tsx --env-file-if-exists=.env.local src/scripts/profile-autoauthor.ts",
    "harness:status": ".cursor/skills/drain-waiting-room/scripts/status.sh",
    "harness:prepare": ".cursor/skills/drain-waiting-room/scripts/prepare.sh",
    "harness:drain": ".cursor/skills/drain-waiting-room/scripts/start-drain.sh",
    "harness:drain-mock": ".cursor/skills/drain-waiting-room/scripts/start-drain-mock.sh",
    "harness:stop": ".cursor/skills/drain-waiting-room/scripts/stop-drain.sh",
    "harness:recover": ".cursor/skills/drain-waiting-room/scripts/recover.sh",
    "harness:restart": ".cursor/skills/drain-waiting-room/scripts/restart-drain.sh",
    "harness:park-scrub": "tsx --env-file-if-exists=.env.local src/scripts/park-scrub-waiting.ts",
    "harness:brain": "tsx --env-file-if-exists=.env.local src/scripts/harness-brain-loop.ts",
    "harness:mock-agent": "tsx --env-file-if-exists=.env.local src/scripts/harness-agent-session.ts",
    "harness:supervisor": "tsx --env-file-if-exists=.env.local src/scripts/harness-supervisor.ts"
  },
  "bin": {
    "intelligence-mcp": "./dist/mcp/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@fastify/cors": "^11.0.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@mozilla/readability": "^0.6.0",
    "csv-parse": "^5.6.0",
    "drizzle-orm": "^0.44.2",
    "fast-xml-parser": "^4.5.0",
    "fastify": "^5.3.0",
    "jsdom": "^26.1.0",
    "pg-boss": "^10.3.0",
    "pino": "^9.6.0",
    "postgres": "^3.4.5",
    "robots-parser": "^3.0.1",
    "rss-parser": "^3.13.0",
    "zod": "^3.25.67",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.15.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
