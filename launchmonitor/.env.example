# ---- Local launch cache (SQLite via node:sqlite) ----
LM_DB_PATH=./data/launchmonitor.sqlite

# ---- Parent intelligence Postgres (for `sync`) ----
# Same instance the API reads from (see intelligence/.env.local DATABASE_URL).
LM_DATABASE_URL=postgres://copyr_intel:intel@localhost:5434/intelligence

# ---- Okara Launch Library fetching (`fetch`) ----
# Politeness: min gap between paged requests, jittered +50%.
LM_PAGE_GAP_MS=4000
LM_MAX_PAGES=40
LM_LIBRARY_BASE_URL=https://okara.ai

LOG_LEVEL=info
