# ---- Session (REQUIRED for watch/once) ----
# Easiest: `pnpm auth --firefox` / `--profile` reads cookies from your browser.
# Raw cookie header from a logged-in x.com session also works:
XM_COOKIES=
# ...or a file containing the raw header, or a Cookie-Editor JSON export:
XM_COOKIES_FILE=
# Refreshed cookies get persisted here automatically (preferred next run):
XM_SESSION_FILE=./data/x-session.json

# Set to 1 if polls fail with "Unable to resolve the X ondemand chunk URL":
# X serves bot-wall HTML to Node's homepage fetch (TLS fingerprinting);
# searches work fine without the transaction headers when cookies are set.
XM_DISABLE_TXHEADERS=

# ---- Polling ----
XM_POLL_MINUTES=10
XM_MAX_TWEETS_PER_POLL=60

# ---- Strict rate limits (persisted in SQLite, shared by ALL invocations) ----
# Rolling windows; a request consumes budget when sent, success or not.
XM_MAX_SEARCHES_PER_HOUR=10
XM_MAX_SEARCHES_PER_DAY=40
# Minimum enforced gap between two searches (jittered up to +50%).
XM_QUERY_GAP_SECONDS=25

# ---- Digest gates ----
XM_DIGEST_HOURS=24
XM_MIN_SCORE=0.45
XM_MIN_VIEWS=200

# ---- Extra X search queries (comma-separated full query strings) ----
# XM_QUERIES="launching today filter:native_video lang:de","unveiling filter:native_video"

# ---- Storage ----
XM_DB_PATH=./data/xmonitor.sqlite
LOG_LEVEL=info
